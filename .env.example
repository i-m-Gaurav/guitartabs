# Copy to .env for local use (`npm start`). Never commit the real .env.
# On Vercel / Render, set these in the dashboard's Environment Variables instead.

# MongoDB connection string (required for cloud sync)
MONGODB_URII=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/guitartabs?retryWrites=true&w=majority

# Password the app asks for once per device (recommended — the site is public)
APP_PASSWORD=

# Port for server.js (optional)
PORT=3000
