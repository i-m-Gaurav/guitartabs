# Copy to .env for local use (`npm run dev`). Never commit the real .env.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# MongoDB connection string (required for cloud sync)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/guitartabs?retryWrites=true&w=majority

# Password the app asks for once per device (recommended — the site is public)
APP_PASSWORD=
